# Copia este archivo como .env (docker compose lo lee automáticamente).
# Todos los valores son de EJEMPLO: cámbialos antes de desplegar.

# --- PostgreSQL ---
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=cambia-esta-clave

# --- API ---
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080
# Carga usuarios y tickets ficticios si la base está vacía
SEED_DEMO=true
# Asignar automáticamente (round-robin) cada ticket nuevo
AUTO_ASSIGN_ON_CREATE=false
# Frecuencia del job que detecta SLA incumplidos, en ms (0 = desactivado)
SLA_MONITOR_INTERVAL_MS=60000
