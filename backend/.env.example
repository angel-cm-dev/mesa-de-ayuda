# Desarrollo local SIN Docker:  cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Opción A: PostgreSQL local
DB_CLIENT=pg
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# Opción B: SQLite en archivo (no requiere instalar PostgreSQL; usa la devDependency better-sqlite3)
# DB_CLIENT=sqlite
# SQLITE_FILENAME=./dev.sqlite

JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
SEED_DEMO=true
AUTO_ASSIGN_ON_CREATE=false
SLA_MONITOR_INTERVAL_MS=60000
